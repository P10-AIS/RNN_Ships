{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cleaner (conda ships_processing_2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/processing/cleaner.py",
            "cwd": "${workspaceFolder}/processing",
            "console": "integratedTerminal",
            "python": "/opt/conda/envs/ships_processing_2/bin/python",
            "args": [
                "california_coast",
                "-l", "4",
                "-s",
                "--seed", "47033218",
                "--memory", "conserve"
            ]
        },
        {
            "name": "Debug MLflow Run",
            "type": "debugpy",
            "request": "launch",
            "python": "/opt/conda/envs/ships_fitting/bin/python",
            "module": "mlflow",
            "args": [
                "run",
                ".",
                "-e",
                "test_time_gaps",
                "-P", "time_gap=30",
                "-P", "length_of_history=3",
                "-P", "hours_out=1",
                "-P", "loss=haversine",
                "-P", "time_of_day=hour_day",
                "-P", "weather=currents",
                "-P", "dataset_name=california_coast",
                "--experiment-name", "Final",
                "-P", "model_type=long_term_fusion",
                "-P", "sog_cog=raw",
                "-P", "rnn_to_dense_connection=final_node",
                "-P", "batch_size=128",
                "-P", "dense_layer_size=260",
                "-P", "direction=bidirectional",
                "-P", "distance_traveled=ignore",
                "-P", "layer_type=gru",
                "-P", "learning_rate=4.3377454427327665e-05",
                "-P", "number_of_dense_layers=0",
                "-P", "number_of_rnn_layers=5",
                "-P", "rnn_layer_size=280",
                "-P", "extended_recurrent_idxs=vt_dst_and_time",
                "-P", "number_of_fusion_weather_layers=2"
            ],
            "justMyCode": false
        }
    ]
}

